+#[cfg(test)]
+mod tests {
+    use super::Type;
+
+    #[test]
+    fn array_refinement_tracks_per_element_places_for_generic_lengths() {
+        for len in [0, 1, 2, 4, 16] {
+            let array = Type::Array(Box::new(Type::Bool), len);
+            assert_eq!(
+                array.get_rfn_type().to_string(),
+                "list ((place_rfnRT bool))",
+                "array length {len} lost its per-element place refinement"
+            );
+        }
+    }
+
+    #[test]
+    fn malformed_array_refinement_is_detectably_different() {
+        let array = Type::Array(Box::new(Type::Bool), 16);
+        assert_ne!(array.get_rfn_type().to_string(), "list bool");
+    }
+}

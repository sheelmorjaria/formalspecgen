# Provider config for formalspecgen. Copy to .env and fill in:  cp .env.example .env
# Committed template; .env itself is gitignored.

# --- GLM via z.ai — primary working provider ---
# z.ai free package covers ONLY glm-4.5-flash; glm-5.2 etc. error 1113 ("no resource package").
# Path is /api/paas/v4 (not /v1). GLM_THINKING=disabled is REQUIRED: glm-4.5-flash is a
# reasoning model that otherwise truncates the answer / 524s the gateway.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.5-flash
GLM_THINKING=disabled

# --- OpenAI (fallback provider; needs credits) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Ollama (local, free, unlimited fallback) ---
# Pull first:  ollama pull qwen3-coder:30b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3-coder:30b
